# Copy to .env.local and fill in. Never commit .env.local.
# The app runs with every value below left empty (unconfigured mode + mock AI).

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API. Leave empty until a project exists.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Only for seeding/admin scripts; the app does not need it at runtime.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider: mock | anthropic | openai. Real providers are wired in M6.
AI_PROVIDER=mock
# Model ids are chosen and verified against the provider's current model list in M6.
AI_MODEL_CHAT=
AI_MODEL_ANALYSIS=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
