# Copy to .env.local and fill in. Never commit .env.local.
# The app runs with every value below left empty (unconfigured mode + mock AI).

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API. Leave empty until a project exists.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Only for seeding/admin scripts; the app does not need it at runtime.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider: mock (default, no key) | gemini. anthropic / openai are not wired up.
AI_PROVIDER=mock
# Model ids (required for a real provider; never hardcoded). Free-tier Gemini example:
#   AI_MODEL_CHAT=gemini-3.6-flash
#   AI_MODEL_ANALYSIS=gemini-3.6-flash
# Check the model list and your project's free-tier limits in Google AI Studio.
AI_MODEL_CHAT=
AI_MODEL_ANALYSIS=
# Server-only. Google AI Studio → Get API key. Leave billing off to stay on the free tier:
# the app never switches to a paid service; a used-up quota (429) shows a clear message.
GEMINI_API_KEY=
